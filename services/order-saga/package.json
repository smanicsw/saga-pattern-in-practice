{
  "name": "@saga/order-saga-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/orchestrator/worker.ts",
    "orchestrator:worker": "tsx src/orchestrator/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/orchestrator/worker.js",
    "test": "jest --config jest.config.ts --runInBand",
    "test:functional": "jest --config jest.config.ts --runInBand tests/functional --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:migrate:latest": "knex migrate:latest --knexfile knexfile.cjs",
    "db:migrate:make": "knex migrate:make --knexfile knexfile.cjs"
  },
  "dependencies": {
    "@saga/http-kit": "workspace:*",
    "@saga/outbox-kit": "workspace:*",
    "@sinclair/typebox": "^0.34.49",
    "pino": "^9.7.0",
    "knex": "^3.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.5",
    "pino-pretty": "^13.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3"
  }
}
